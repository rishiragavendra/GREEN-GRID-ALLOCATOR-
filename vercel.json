{
  "functions": {
    "api/index.py": {
      "includeFiles": "{runtime/**,public/**}",
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py?path=:path*"
    },
    {
      "source": "/",
      "destination": "/api/index.py"
    },
    {
      "source": "/:path*",
      "destination": "/api/index.py"
    }
  ]
}